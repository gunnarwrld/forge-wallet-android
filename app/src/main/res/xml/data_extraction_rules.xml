<?xml version="1.0" encoding="utf-8"?>
<!-- Ledger Forge is the system of record, so nothing local is backed up or moved to a new
     device: no stale balances, no cached statement, no outbox rows replayed from a snapshot. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
